<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <xacro:property name="base_length" value="0.20"/>
    <xacro:property name="base_width" value="0.18"/>
    <xacro:property name="base_height" value="0.10"/>

    <xacro:property name="wheel_radius" value="0.04"/>
    <xacro:property name="wheel_width" value="0.03"/>


    <xacro:property name="wheel_track" value="0.25"/>


    <xacro:property name="wheel_base" value="0.18"/>


    <xacro:property name="lidar_radius" value="0.04"/>
    <xacro:property name="lidar_height" value="0.06"/>


    <link name="base_footprint"/>

    <link name="base_link">

        <visual>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>

        <xacro:box_inertial
            m="6.0"
            x="${base_length}"
            y="${base_width}"
            z="${base_height}"
            o_xyz="0 0 ${base_height/2}"
            o_rpy="0 0 0"/>

    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>


    <xacro:macro name="wheel" params="name x y">

        <link name="${name}_wheel_link">

            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}"
                              length="${wheel_width}"/>
                </geometry>
                <material name="gray"/>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}"
                              length="${wheel_width}"/>
                </geometry>
            </collision>

            <xacro:cylinder_inertial
                m="0.5"
                r="${wheel_radius}"
                l="${wheel_width}"
                o_xyz="0 0 0"
                o_rpy="${pi/2} 0 0"/>

        </link>

        <joint name="${name}_wheel_joint"
               type="continuous">

            <parent link="base_link"/>
            <child link="${name}_wheel_link"/>

            <origin xyz="${x} ${y} 0"/>

            <axis xyz="0 1 0"/>

        </joint>

    </xacro:macro>

   
    <xacro:wheel
        name="front_left"
        x="${wheel_base/2}"
        y="${wheel_track/2}"/>

    <xacro:wheel
        name="front_right"
        x="${wheel_base/2}"
        y="${-wheel_track/2}"/>

    <xacro:wheel
        name="rear_left"
        x="${-wheel_base/2}"
        y="${wheel_track/2}"/>

    <xacro:wheel
        name="rear_right"
        x="${-wheel_base/2}"
        y="${-wheel_track/2}"/>



    <link name="laser">

        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}"
                          length="${lidar_height}"/>
            </geometry>

            <material name="green"/>

        </visual>

        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}"
                          length="${lidar_height}"/>
            </geometry>
        </collision>

        <xacro:cylinder_inertial
            m="0.30"
            r="${lidar_radius}"
            l="${lidar_height}"
            o_xyz="0 0 0"
            o_rpy="0 0 0"/>

    </link>

    <joint name="lidar_joint"
           type="fixed">

        <parent link="base_link"/>
        <child link="laser"/>

        <origin xyz="0 0 ${base_height + lidar_height/2}"
                rpy="0 0 0"/>

    </joint>

</robot>

